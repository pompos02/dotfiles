#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
	printf 'usage: aimux set AGENT [working|waiting|done] | clear | acknowledge [PANE] | list | count | pick\n' >&2
	exit 2
}

pane_option() {
	tmux set-option -p -t "$1" "$2" "$3" 2>/dev/null || true
}

clear_option() {
	tmux set-option -pu -t "$1" "$2" 2>/dev/null || true
}

acknowledge() {
	local pane=${1:-${TMUX_PANE:-}} status
	[[ -n "$pane" ]] || return 0
	status="$(tmux show-option -pqv -t "$pane" @aimux_status 2>/dev/null || true)"
	if [[ "$status" == waiting || "$status" == done ]]; then
		clear_option "$pane" @aimux_status
	fi
}

set_status() {
	local agent=${1:-} status=${2:-} pane=${TMUX_PANE:-}
	[[ "$agent" == opencode || "$agent" == copilot ]] || usage
	[[ -z "$status" || "$status" == working || "$status" == waiting || "$status" == done ]] || usage
	[[ -n "$pane" ]] || return 0

	pane_option "$pane" @aimux_agent "$agent"
	if [[ -n "$status" ]]; then
		pane_option "$pane" @aimux_status "$status"
	else
		clear_option "$pane" @aimux_status
	fi

	if [[ "$status" == waiting || "$status" == done ]] &&
		[[ "$(tmux display-message -p -t "$pane" '#{&&:#{pane_active},#{&&:#{window_active},#{session_attached}}}' 2>/dev/null || true)" == 1 ]]; then
		acknowledge "$pane"
	fi
}

clear_status() {
	local pane=${TMUX_PANE:-}
	[[ -n "$pane" ]] || return 0
	clear_option "$pane" @aimux_agent
	clear_option "$pane" @aimux_status
}

list_agents() {
	local pane agent status target path
	while IFS=$'\t' read -r pane agent status target path; do
		if [[ "$agent" != - ]]; then
			printf '%s\t%s\t%s\t%s\t%s\n' "$pane" "$agent" "$status" "$target" "$path"
		fi
	done < <(tmux list-panes -a -F $'#{pane_id}\t#{?@aimux_agent,#{@aimux_agent},-}\t#{?@aimux_status,#{@aimux_status},idle}\t#{session_name}:#{window_index}.#{pane_index}\t#{pane_current_path}' 2>/dev/null || true)
}

count_agents() {
	list_agents | awk -F '\t' '
		{ count[$3]++ }
		END { printf "[%d,%d,%d,%d]", count["working"], count["waiting"], count["idle"], count["done"] }
	'
}

pick_agent() {
	local selected pane
	selected="$(
		list_agents | while IFS=$'\t' read -r pane agent status target path; do
			printf '%s\t%-7s %-8s %-20s %s\n' "$pane" "$status" "$agent" "$(basename "$path")" "$target"
		done | fzf --delimiter=$'\t' --with-nth=2 --prompt='agents> ' --border=rounded --info=right
	)" || return 0
	[[ -n "$selected" ]] || return 0
	tmux switch-client -t "${selected%%$'\t'*}"
}

case ${1:-} in
	set) shift; set_status "$@" ;;
	clear) clear_status ;;
	acknowledge) acknowledge "${2:-}" ;;
	list) list_agents ;;
	count) count_agents ;;
	pick) pick_agent ;;
	*) usage ;;
esac
