# shellcheck shell=sh

export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

path_prepend() {
	[ -d "$1" ] || return 0
	case ":$PATH:" in
	*":$1:"*) ;;
	*) PATH="$1:$PATH" ;;
	esac
}

path_append() {
	[ -d "$1" ] || return 0
	case ":$PATH:" in
	*":$1:"*) ;;
	*) PATH="$PATH:$1" ;;
	esac
}

path_prepend /usr/local/bin
path_prepend "$HOME/.local/bin"
path_prepend "$HOME/.npm-global/bin"
path_prepend "$HOME/.config/scripts"
path_prepend "$HOME/.config/bin"
path_prepend "$HOME/.opencode/bin"
path_prepend "$HOME/.cargo/bin"
path_append "$HOME/go/bin"
path_append "$HOME/.local/zig"

if [ -d /opt/oracle/instantclient_19_29 ]; then
	export ORACLE_HOME=/opt/oracle/instantclient_19_29
	export LD_LIBRARY_PATH="$ORACLE_HOME${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
	export TNS_ADMIN=/opt/oracle/wallet
	path_append "$ORACLE_HOME"
	path_prepend "$ORACLE_HOME/sdk"
fi

export PATH
export EDITOR="${EDITOR:-nvim}"
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
export CRYPTOGRAPHY_OPENSSL_NO_LEGACY=1

fzf_theme_file="$XDG_CACHE_HOME/theme/current_fzf"
[ -f "$fzf_theme_file" ] && export FZF_DEFAULT_OPTS_FILE="$fzf_theme_file"
